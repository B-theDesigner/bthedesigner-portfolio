-    max-height 300ms cubic-bezier(0.4, 0, 0.2, 1),
+    height 300ms cubic-bezier(0.4, 0, 0.2, 1),
     opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
 }
 
