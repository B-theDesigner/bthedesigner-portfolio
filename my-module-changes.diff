+/* ─── Tier-1 mobile select ───────────────────────────────────────────────── */
+/* Built by gallery-tab-select.js from the Tier-1 tabs, using the design-system
+   Select. Hidden above 640px; swaps in for the tabs at 640px and below.
+   Scoped under .GalleryTabs (0,2,0) so it beats .Select from select.css
+   regardless of stylesheet order. */
+
+.GalleryTabs .GalleryTabs-select {
+  display: none;
+  max-width: none;
+  margin-bottom: var(--spacing-base);
+}
+
+/* No helper copy here, so drop the reserved message row */
+.GalleryTabs .GalleryTabs-select .Select-message {
+  display: none;
+}
+
+@media (max-width: 640px) {
+  .GalleryTabs .GalleryTabs-select {
+    display: flex;
+  }
+
+  .GalleryTabs-tier1 {
+    display: none;
+  }
+}
+
